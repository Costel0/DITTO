rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidProfileFields() {
        return !request.resource.data.keys().hasAny([
          'username',
          'initialDuplicateId'
        ]) || (
          request.resource.data.keys().hasAll([
            'username',
            'initialDuplicateId'
          ])
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 24
          && request.resource.data.initialDuplicateId is string
          && request.resource.data.initialDuplicateId in [
            '01',
            '02',
            '03',
            '04',
            '05'
          ]
        );
      }

      function hasValidProfileShape() {
        return request.resource.data.keys().hasOnly([
          'email',
          'username',
          'initialDuplicateId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && hasValidProfileFields();
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && hasValidProfileShape();
      allow delete: if false;

      match /survivors/{survivorId} {
        // Survivor creation and gameplay mutations are server-authoritative.
        allow read: if isOwner();
        allow create, update, delete: if false;
      }

      match /state/{stateId} {
        // BunkerState is server-authoritative. The Flutter client may only read
        // its own bunker snapshot. Admin SDK writes from Cloud Functions bypass
        // these client security rules.
        allow read: if isOwner() && stateId == 'bunker';
        allow create, update, delete: if false;
      }
    }

    match /items/{itemId} {
      // Item definitions are a shared server-authored catalog. Authenticated
      // clients may read them, but gameplay data is never client-writable.
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /serverData/{document=**} {
      // Private balance/configuration data. Only trusted backend code using the
      // Firebase Admin SDK may access it; Admin SDK bypasses these client rules.
      allow read, write: if false;
    }
  }
}
