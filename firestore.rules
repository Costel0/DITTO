rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidProfileFields() {
        return !request.resource.data.keys().hasAny([
          'username',
          'initialDuplicateId'
        ]) || (
          request.resource.data.keys().hasAll([
            'username',
            'initialDuplicateId'
          ])
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 24
          && request.resource.data.initialDuplicateId is string
          && request.resource.data.initialDuplicateId in [
            '01',
            '02',
            '03',
            '04'
          ]
        );
      }

      function hasValidProfileShape() {
        return request.resource.data.keys().hasOnly([
          'email',
          'username',
          'initialDuplicateId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && hasValidProfileFields();
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && hasValidProfileShape();
      allow delete: if false;

      match /survivors/{survivorId} {
        function hasValidStatMods() {
          return request.resource.data.statMods is map
            && request.resource.data.statMods.keys().hasOnly([
              'strength',
              'agility',
              'endurance',
              'scavenging'
            ])
            && request.resource.data.statMods.keys().hasAll([
              'strength',
              'agility',
              'endurance',
              'scavenging'
            ])
            && request.resource.data.statMods.strength is int
            && request.resource.data.statMods.agility is int
            && request.resource.data.statMods.endurance is int
            && request.resource.data.statMods.scavenging is int;
        }

        function hasValidSurvivorShape() {
          return request.resource.data.keys().hasOnly([
            'duplicateId',
            'statMods',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.duplicateId is string
          && request.resource.data.duplicateId in [
            '01',
            '02',
            '03',
            '04'
          ]
          && hasValidStatMods();
        }

        allow read: if isOwner();
        allow create, update: if isOwner() && hasValidSurvivorShape();
        allow delete: if isOwner();
      }
    }
  }
}
