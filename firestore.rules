rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidProfileFields() {
        return !request.resource.data.keys().hasAny([
          'username',
          'initialDuplicateId'
        ]) || (
          request.resource.data.keys().hasAll([
            'username',
            'initialDuplicateId'
          ])
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 24
          && request.resource.data.initialDuplicateId is string
          && request.resource.data.initialDuplicateId in [
            '01',
            '02',
            '03',
            '04'
          ]
        );
      }

      function hasValidProfileShape() {
        return request.resource.data.keys().hasOnly([
          'email',
          'username',
          'initialDuplicateId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && hasValidProfileFields();
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && hasValidProfileShape();
      allow delete: if false;

      match /survivors/{survivorId} {
        function hasValidStatMods() {
          return request.resource.data.statMods is map
            && request.resource.data.statMods.keys().hasOnly([
              'strength',
              'dexterity',
              'constitution',
              'stealth',
              'care',
              'cunning',
              'charm'
            ])
            && request.resource.data.statMods.keys().hasAll([
              'strength',
              'dexterity',
              'constitution',
              'stealth',
              'care',
              'cunning',
              'charm'
            ])
            && request.resource.data.statMods.strength is int
            && request.resource.data.statMods.dexterity is int
            && request.resource.data.statMods.constitution is int
            && request.resource.data.statMods.stealth is int
            && request.resource.data.statMods.care is int
            && request.resource.data.statMods.cunning is int
            && request.resource.data.statMods.charm is int;
        }

        function hasValidSurvivorShape() {
          return request.resource.data.keys().hasOnly([
            'id',
            'duplicateId',
            'statMods',
            'healthHistory',
            'equippedItemIds',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.id is string
          && request.resource.data.id == survivorId
          && request.resource.data.duplicateId is string
          && request.resource.data.duplicateId in [
            '01',
            '02',
            '03',
            '04'
          ]
          && request.resource.data.healthHistory is list
          && request.resource.data.equippedItemIds is list
          && hasValidStatMods();
        }

        // Kept temporarily for development helpers and legacy migrations.
        // Gameplay mutations will progressively move behind Cloud Functions.
        allow read: if isOwner();
        allow create, update: if isOwner() && hasValidSurvivorShape();
        allow delete: if isOwner();
      }

      match /state/{stateId} {
        // BunkerState is server-authoritative. The Flutter client may only read
        // its own bunker snapshot. Admin SDK writes from Cloud Functions bypass
        // these client security rules.
        allow read: if isOwner() && stateId == 'bunker';
        allow create, update, delete: if false;
      }
    }
  }
}
