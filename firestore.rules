rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidProfileFields() {
        return !request.resource.data.keys().hasAny([
          'username',
          'characterId'
        ]) || (
          request.resource.data.keys().hasAll([
            'username',
            'characterId'
          ])
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 24
          && request.resource.data.characterId is string
          && request.resource.data.characterId in [
            'survivor_01',
            'survivor_02',
            'survivor_03',
            'survivor_04'
          ]
        );
      }

      function hasValidProfileShape() {
        return request.resource.data.keys().hasOnly([
          'email',
          'username',
          'characterId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && hasValidProfileFields();
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && hasValidProfileShape();
      allow delete: if false;
    }
  }
}
