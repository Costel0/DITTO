{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ditto://schemas/bunker-state-v2",
  "title": "BunkerState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "serverUpdatedAt",
    "survivors",
    "idleSurvivors",
    "busySurvivors",
    "inventory"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "serverUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "survivors": {
      "type": "array",
      "items": { "$ref": "#/$defs/survivor" }
    },
    "idleSurvivors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "busySurvivors": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "$defs": {
    "survivor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "duplicateId",
        "statMods",
        "healthHistory",
        "equippedItemIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "duplicateId": {
          "type": "string",
          "minLength": 1
        },
        "statMods": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strength",
            "dexterity",
            "constitution",
            "stealth",
            "care",
            "cunning",
            "charm"
          ],
          "properties": {
            "strength": { "type": "integer" },
            "dexterity": { "type": "integer" },
            "constitution": { "type": "integer" },
            "stealth": { "type": "integer" },
            "care": { "type": "integer" },
            "cunning": { "type": "integer" },
            "charm": { "type": "integer" }
          }
        },
        "healthHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "recordedAt"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "recordedAt": {
                "type": "string",
                "format": "date-time"
              },
              "details": { "type": "string" }
            }
          }
        },
        "equippedItemIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
