{
  "name": "ditto-functions",
  "private": true,
  "main": "bootstrap.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "sync:items": "node scripts/sync_items_catalog.js",
    "sync:items:check": "node scripts/sync_items_catalog.js --dry-run",
    "sync:items:exact": "node scripts/sync_items_catalog.js --prune",
    "sync:server-data": "node scripts/sync_server_data.js",
    "sync:server-data:check": "node scripts/sync_server_data.js --dry-run",
    "sync:server-data:exact": "node scripts/sync_server_data.js --prune",
    "map": "node scripts/map_admin.js",
    "map:init": "node scripts/map_admin.js init",
    "map:expand": "node scripts/map_admin.js expand",
    "map:add-players": "node scripts/map_admin.js add-players",
    "map:download": "node scripts/map_admin.js download",
    "map:render": "node scripts/map_admin.js render",
    "map:edit": "node scripts/map_edit.js",
    "map:set-sector": "node scripts/map_edit.js set-sector",
    "map:set-zone": "node scripts/map_edit.js set-zone",
    "users": "node scripts/user_admin.js",
    "users:clear-data": "node scripts/user_admin.js clear-data"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  }
}
